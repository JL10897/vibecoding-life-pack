#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
PRINCIPLES_FILE="$REPO_ROOT/canonical/shared/principles/AgentPrinciples.md"

if [[ ! -f "$PRINCIPLES_FILE" ]]; then
  echo "vibe-print-cursor-user-rules: missing $PRINCIPLES_FILE" >&2
  exit 1
fi

cat "$PRINCIPLES_FILE"
