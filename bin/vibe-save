#!/usr/bin/env bash
set -euo pipefail

SOURCE="manual"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --source)
      SOURCE="${2:-manual}"
      shift 2
      ;;
    *)
      echo "Unknown argument: $1" >&2
      exit 2
      ;;
  esac
done

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
DEVICE_ID="${VIBE_DEVICE_ID:-$(hostname | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9._-' '-')}"
TIMESTAMP="$(date -u +"%Y-%m-%dT%H:%M:%SZ")"

cd "$REPO_ROOT"

# Pull any skills created directly in a consumer dir back into the canonical
# shared skills location before staging, so cross-platform authoring lands in
# the repo and gets committed. Idempotent; safe to run every save.
if [[ -x "$REPO_ROOT/bin/vibe-absorb-skills" ]]; then
  "$REPO_ROOT/bin/vibe-absorb-skills" || echo "vibe-save: vibe-absorb-skills reported a non-zero exit; continuing."
fi

if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  echo "vibe-save: $REPO_ROOT is not a git repository; skipping autosave."
  exit 0
fi

GIT_TOPLEVEL="$(git rev-parse --show-toplevel)"
if [[ "$GIT_TOPLEVEL" != "$REPO_ROOT" ]]; then
  echo "vibe-save: $REPO_ROOT is inside another git repository; skipping autosave until it is initialized as its own repo."
  exit 0
fi

GIT_DIR="$(git rev-parse --git-dir)"
if [[ -f "$GIT_DIR/MERGE_HEAD" || -d "$GIT_DIR/rebase-merge" || -d "$GIT_DIR/rebase-apply" ]]; then
  echo "vibe-save: merge or rebase in progress; resolve it before autosave."
  exit 0
fi

if [[ -z "$(git status --porcelain)" ]]; then
  echo "vibe-save: no changes."
  exit 0
fi

git add -A

if [[ -z "$(git diff --cached --name-only)" ]]; then
  echo "vibe-save: no staged changes after add."
  exit 0
fi

AUTHOR_NAME="$(git config user.name || true)"
AUTHOR_EMAIL="$(git config user.email || true)"
AUTHOR_NAME="${AUTHOR_NAME:-Life Pack Autosave}"
AUTHOR_EMAIL="${AUTHOR_EMAIL:-life-pack-autosave@localhost}"

COMMIT_MESSAGE="$(cat <<EOF
chore(life-pack): autosave changes from $SOURCE on $DEVICE_ID

Source: $SOURCE
Device: $DEVICE_ID
Timestamp: $TIMESTAMP
EOF
)"

git \
  -c user.name="$AUTHOR_NAME" \
  -c user.email="$AUTHOR_EMAIL" \
  commit -m "$COMMIT_MESSAGE"

echo "vibe-save: autosaved changes from $SOURCE on $DEVICE_ID."
